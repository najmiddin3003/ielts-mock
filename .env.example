# Bu fayl faqat namuna. Haqiqiy qiymatlar Vercel → Project → Settings → Environment Variables'ga kiritiladi.
# Lokal test uchun nusxalab .env deb nomlang (u .gitignore orqali git'dan yashirilgan).

# Majburiy
OPENAI_API_KEY=sk-...

# Ixtiyoriy
# OPENAI_MODEL=gpt-4o
# ALLOWED_ORIGINS=https://sizning-domeningiz.uz,https://www.sizning-domeningiz.uz
# RATE_LIMIT_PER_HOUR=20
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
